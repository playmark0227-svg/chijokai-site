// 知上会 管理画面の中継（Cloudflare Worker）の設定
// 使い方は worker/README.md を参照。
// ここには公開してよい値だけを書く。GitHub のトークンなどの秘密の値は
//   npx wrangler secret put GITHUB_TOKEN
// のように登録し、このファイルやリポジトリには絶対に書かない。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chijoukai-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Google Cloud の「OAuth クライアント ID」（ウェブ アプリケーション）。公開してよい値
    "GOOGLE_CLIENT_ID": "",
    // 管理画面を使える Google アカウント（カンマ区切り）。追加・削除したら再デプロイする
    "ALLOWED_EMAILS": "info@chijoukai.com",
    // 管理画面のオリジン（この Worker を呼んでよいページ）。独自ドメインに移ったら追加する
    "ALLOWED_ORIGINS": "https://playmark0227-svg.github.io",
    "GITHUB_REPO": "playmark0227-svg/chijokai-site",
    "GITHUB_BRANCH": "main"
  }
}
